[Unit]
Description=DuneCity browser matchmaking
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/dunecity-matchmaking/current
ExecStart=/opt/dunecity-matchmaking/node/bin/node /opt/dunecity-matchmaking/current/run.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
CapabilityBoundingSet=
UMask=0077
MemoryMax=192M
TasksMax=64

[Install]
WantedBy=multi-user.target
